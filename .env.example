# Optional LLM provider keys for grounded chat. The app also supports BYOK
# entry in the browser session, so these can be left blank for demo mode.
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: pin the Python executable used by the Express API.
# If unset, the server uses .venv/bin/python when present, then falls back to python3.
PYTHON_BIN=
